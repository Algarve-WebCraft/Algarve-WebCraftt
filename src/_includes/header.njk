<header id="header" class="home-header header" data-swup-replace="header">
  <a href="#swup" class="skip-to-content">{{ language.nav.skip }}</a>

  <div class="header__container">
    <div class="wrapper wrapper--header">

      <div class="business-logo-container">
        <a href="{{ language.nav.logo_link }}">
          <img id="business-logo" src="/assets/logos/business-logo-white.webp" class="business-logo" width="140" height="40" fetchpriority="high" loading="eager" alt="Algarve Webcraft's business logo.">
        </a>
      </div>

      <div id="swup-header" class="swup-header">
        <nav id="navigation" class="nav-bar">
          <ul>
            <li><a href="{{ language.nav.home.url }}">{{ language.nav.home.text }}</a></li>
            <li><a href="{{ language.nav.about.url }}">{{ language.nav.about.text }}</a></li>
            <li><a href="{{ language.nav.work.url }}">{{ language.nav.work.text }}</a></li>
            <li><a href="{{ language.nav.pricing.url }}">{{ language.nav.pricing.text }}</a></li>
            <li><a href="{{ language.nav.contact.url }}">{{ language.nav.contact.text }}</a></li>
          </ul>
        </nav>

        <div class="hamburger-btn-box">
          <div class="flag-container">
            <a href="{{ language_pt }}" aria-label="Toggle the language to select Portuguese">
