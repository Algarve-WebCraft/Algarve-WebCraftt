<!DOCTYPE html>
<html lang="en" class="is-loading">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="{{ description }}">
    <meta name="theme-color" content="#0a0b0f">
    <link rel="icon" type="image/x-icon" href="/assets/logos/favicon-logo.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/logos/favicon-logo-16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/logos/favicon-logo-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/logos/favicon-logo-apple.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/logos/favicon-logo-chrome.png">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/geist-v5-latin-regular.woff2">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/geist-v5-latin-500.woff2">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/geist-v5-latin-600.woff2">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/geist-mono-v6-latin-500.woff2">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/GeneralSans-VariableItalic.woff2">
    <link rel="preload" href="/css/critical.css" as="style">
    <link rel="stylesheet" href="/css/critical.css">
    <link rel="stylesheet" href="/css/style-main.css">
    <link rel="stylesheet" href="/css/style-pages.css">
    <link rel="preload" as="image" type="image/webp" href="/assets/logos/business-logo-white.webp">
    <script type="module" src="/js/bundle.js"></script>
    <script src="/js/gsap.min.js" defer></script>
    <script src="/js/scrolltrigger.min.js" defer></script>
    <title>{{ title }}</title>
  </head>
  <body class="{{ body_class }}">
    {% include "header.njk" %}
    {% include "decor.njk" %}

    <main id="swup" class="transition-slide">
      {% block content %}{% endblock %}
    </main>

    <div class="contact-toast" id="toast" aria-live="polite">
        <div class="toast__content">
          <strong class="toast__title">Message sent!</strong>
          <p class="toast__text">Thanks for getting in touch. I'll reply as soon as I can.</p>
        </div>
      </div>

    {% include "footer.njk" %} 
  </body>
</html>