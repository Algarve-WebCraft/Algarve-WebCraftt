{% extends "base.njk" %}

{% block content %}
<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ SECTION-ONE / HERO ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

<section class="cmp-hero-section" aria-labelledby="hero-section">
  <div class="wrapper wrapper--tablet-48">

    <div class="cmp-header-text-container cmp-header-text-container--pg6-s1">
      <span class="cmp-topper-heading cmp-topper-heading--portfolio">{{ topper_heading }}</span>
      <h1 id="hero-section" class="cmp-hero-heading">{{ hero_title }} <span class="cmp-heading-span cmp-heading-span--hero cmp-gradient-text">{{ hero_span }}</span></h1>
      <p class="cmp-main-text">{{ hero_text }}</p>
      <p class="cmp-main-text">Click below to discover {{ hero_text_inner }} for yourself</p>

      <div class="sub-block-container">
        <span>{{ span_block_1 }}</span>
        <span>{{ span_block_2 }}</span>
        <span>{{ span_block_3 }}</span>
        <span>{{ span_block_4 }}</span>
      </div>
    </div>

    <a href="{{ hero_image_link }}" target="_blank" rel="noopener noreferrer">
      <img class="portfolio-hero-image" src="{{ hero_image_image }}" alt="The website and link for {{ hero_image_alt }}" decoding="async">
    </a>

  </div>
</section>

