      <p class="cmp-main-text">{{ terms_text_10 }}</p>
      <ul class="cmp-main-text terms-privacy-list">
        <li>{{ terms_5_li_1 }}</li>
        <li>{{ terms_5_li_2 }}</li>
        <li>{{ terms_5_li_3 }}</li>
        <li>{{ terms_5_li_4 }}</li>
      </ul>
    </div>

    <div id="governing-law" class="terms-privacy-section">
      <h2 class="cmp-sub-heading cmp-sub-heading--terms-privacy">11. {{ terms_heading_11 }}</h2>
      <p class="cmp-main-text">{{ terms_text_11 | safe }}</p>
    </div>

    <div id="changes" class="terms-privacy-section">
      <h2 class="cmp-sub-heading cmp-sub-heading--terms-privacy">12. {{ terms_heading_12 }}</h2>
      <p class="cmp-main-text">{{ terms_text_12 }}</p>
    </div>

    <div id="contact" class="terms-privacy-section">
      <h2 class="cmp-sub-heading cmp-sub-heading--terms-privacy">13. {{ terms_heading_13 }}</h2>
      <p class="cmp-main-text">{{ terms_text_13 }}</p>
      <ul class="cmp-main-text terms-privacy-list">
        <li>{{ terms_6_li_1 }}<a href="mailto:algarvewebcraft@gmail.com">algarvewebcraft@gmail.com</a></li>
        <li>{{ terms_6_li_2 }}</li>
      </ul>
